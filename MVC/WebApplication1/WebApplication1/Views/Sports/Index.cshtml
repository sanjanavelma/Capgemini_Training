@model WebApplication1.Models.PagedSports

<h2 class="mt-4">Sports List</h2>

<table class="table table-bordered table-striped w-50 mt-3">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Sport</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Sports)
        {
            <tr>
                <td>@item.id</td>
                <td>@item.Name</td>
                <td>@item.SportName</td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination">

        @if (Model.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link" href="/Sports?page=@(Model.CurrentPage - 1)">Previous</a>
            </li>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link" href="/Sports?page=@i">@i</a>
            </li>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <li class="page-item">
                <a class="page-link" href="/Sports?page=@(Model.CurrentPage + 1)">Next</a>
            </li>
        }

    </ul>
</nav>