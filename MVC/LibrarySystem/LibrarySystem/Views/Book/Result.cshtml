@model LibrarySystem.Models.Book

<h2>Book Result</h2>

<a href="/Book/Search" class="btn btn-secondary mb-2">Back</a>

@if (Model != null)
{
    <table class="table table-bordered">
        <tr>
            <th>Name</th>
            <td>@Model.Name</td>
        </tr>

        <tr>
            <th>Author</th>
            <td>@Model.Author</td>
        </tr>

        <tr>
            <th>Price</th>
            <td>₹@Model.Price</td>
        </tr>
    </table>
}
else
{
    <p class="text-danger">Book Not Found</p>
}