@model List<LibrarySystem.Models.Book>

<h2 class="text-center">Library Books</h2>

<div class="mb-3">
    <a href="/Book/Above500" class="btn btn-primary">Books Above ₹500</a>
    <a href="/Book/Search" class="btn btn-success">Search Book</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Author</th>
            <th>Price</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.Id</td>
                <td>@b.Name</td>
                <td>@b.Author</td>
                <td>₹@b.Price</td>
            </tr>
        }
    </tbody>
</table>